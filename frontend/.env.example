# ==============================================================================
# GAMING CAFE FRONTEND — CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Strict Client-Server Isolation Directives:
# 1. ONLY variables prefixed with 'VITE_' will be exposed to the client bundle.
# 2. NEVER put database credentials, private API keys, or JWT secrets in this file.
# 3. Copy this template to '.env.local' for local development overrides:
#      cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & WEBSOCKET ENDPOINTS
# ------------------------------------------------------------------------------
# Base API URL consumed by the React single-page application.
# Leave blank when served behind the same Nginx/Cloudflare reverse proxy (relative URLs).
# Format: https://api.yourdomain.com (Do NOT include trailing slash)
VITE_API_BASE_URL=

# WebSocket URL for real-time live events.
# Leave blank to auto-detect window.location.host in production (recommended).
# Format: wss://api.yourdomain.com
VITE_WS_URL=

# ------------------------------------------------------------------------------
# 2. TUNNEL & DEV MODES
# ------------------------------------------------------------------------------
# Set to 'true' only when proxying development HMR over TLS Cloudflare Quick Tunnels.
# Production deployments must set this to 'false'.
VITE_GLOBAL_MODE=false
