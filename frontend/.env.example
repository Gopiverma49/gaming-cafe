# ==============================================================================
# GAMING CAFE FRONTEND — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# Target Infrastructure: Vercel (SPA) connecting to Render (Backend & WebSockets)
# ==============================================================================
# Strict Client-Server Isolation Directives:
# 1. ONLY variables prefixed with 'VITE_' will be exposed to the client bundle.
# 2. NEVER put database credentials, private API keys, or JWT secrets in this file.
# 3. For local development, copy this file to '.env.local':
#      cp .env.example .env.local
# 4. In Vercel Project Settings, add these variables under "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API & WEBSOCKET ENDPOINTS (REQUIRED ON VERCEL)
# ------------------------------------------------------------------------------
# Base API URL pointing to the Render backend service.
# Format: https://<your-render-service>.onrender.com (Do NOT include trailing slash or /api)
# In local development, leave empty to use Vite's reverse proxy (sub-5ms latency).
# In production on Vercel, this MUST be set to your Render backend's public HTTPS URL.
VITE_API_BASE_URL=https://gaming-cafe-api.onrender.com

# WebSocket URL for real-time station status, active session timers, and orders.
# Format: wss://<your-render-service>.onrender.com (Do NOT include trailing slash or /ws)
# NOTE FOR VERCEL DEPLOYMENT:
# Vercel serverless hosting cannot host or proxy WebSockets. You MUST configure
# this variable to point directly to Render via wss://. If omitted in production,
# the frontend skips WebSocket connections and displays a console warning to avoid
# broken loopbacks.
VITE_WS_URL=wss://gaming-cafe-api.onrender.com

# ------------------------------------------------------------------------------
# 2. TUNNEL & DEV HMR MODES
# ------------------------------------------------------------------------------
# Set to 'true' ONLY when proxying local development HMR over TLS Cloudflare Quick Tunnels.
# Production deployments on Vercel MUST set this to 'false'.
VITE_GLOBAL_MODE=false
