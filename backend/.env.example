# ==============================================================================
# GAMING CAFE BACKEND — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# Target Infrastructure: Render (API & WebSockets) + Supabase (PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & NETWORK BINDING
# ------------------------------------------------------------------------------
# Environment mode: 'production' | 'development' | 'test'
# NOTE: Setting 'production' enables fail-fast validation that rejects default
# passwords, default JWT secrets, wildcards in CORS, and SQLite databases.
NODE_ENV=production

# Interface binding (0.0.0.0 binds to all network interfaces for Docker/Render)
HOST=0.0.0.0

# Port binding. On Render, the $PORT environment variable is dynamically injected
# by the platform. For local development or Docker, defaults to 8000.
PORT=8000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Asynchronous database connection string (SQLAlchemy asyncpg dialect).
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
#
# Supabase Connection Modes:
# - Transaction Pooler (Supavisor / Port 6543 - Recommended for serverless/Render):
#   DATABASE_URL=postgresql+asyncpg://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   (The backend automatically detects port 6543 / pooler.supabase and disables statement cache)
# - Direct Connection (Session / Port 5432):
#   DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
#
# Local Development Fallback:
#   DATABASE_URL=sqlite+aiosqlite:///./gaming_cafe_dev.db
# WARNING: SQLite is strictly forbidden in production and will prevent server boot.
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:your_supabase_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Log all executed SQL queries (keep 'false' in production for performance and security)
ECHO_SQL=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (STRICT ENFORCEMENT)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key used for signing JWT tokens.
# Must be at least 32 characters in production. (Generate via: openssl rand -hex 32)
# WARNING: Application will crash at startup if left with the default key in production.
JWT_SECRET=replace_with_secure_random_64_char_hex_secret_key_in_production

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_MINUTES=360

# Initial Root System Administrator Credentials
# Automatically provisioned at first server startup; synchronizes password if updated.
ADMIN_USERNAME=admin
# WARNING: Must be at least 8 characters. Default 'admin123' is rejected in production.
ADMIN_PASSWORD=replace_with_complex_admin_passphrase_2026
ADMIN_PHONE=0000000000

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK RESTRICTIONS (ALLOWED_ORIGINS)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized origins allowed to make API requests.
# Set this to your exact Vercel production frontend domain and custom domains.
# Format: https://your-gaming-cafe.vercel.app,https://admin.yourdomain.com
# WARNING: Wildcard '*' is strictly prohibited in production and rejected at boot.
ALLOWED_ORIGINS=https://your-gaming-cafe.vercel.app
CORS_ORIGINS=https://your-gaming-cafe.vercel.app

# ------------------------------------------------------------------------------
# 5. BUSINESS LOGISTICS & UPI PAYMENTS (UPI_*)
# ------------------------------------------------------------------------------
# UPI Virtual Payment Address (VPA) for dynamic Bharat QR code generation
UPI_MERCHANT_VPA=gamingcafe@upi

# Business name displayed on UPI payment apps (Google Pay, PhonePe, Paytm)
UPI_MERCHANT_NAME=ApexCyberLounge

# Currency code (default: INR)
UPI_CURRENCY=INR

# Default rate per hour in INR for billing calculations
DEFAULT_HOURLY_RATE=180.0
DEFAULT_SESSION_DURATION_MINUTES=60
MINIMUM_BILLING_MINUTES=30
GRACE_PERIOD_MINUTES=5

# Idempotency cache configurations
IDEMPOTENCY_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=2000
