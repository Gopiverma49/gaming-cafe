# ==============================================================================
# GAMING CAFE BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Runtime Environment ('production' | 'development' | 'test')
NODE_ENV=development
HOST=0.0.0.0
PORT=8000

# Database Connection URL
# Local Dev fallback: sqlite+aiosqlite:///./gaming_cafe_dev.db
# PostgreSQL:        postgresql+asyncpg://cafe_admin:cyber_secret_2026@localhost:5432/gaming_cafe_db
DATABASE_URL=sqlite+aiosqlite:///./gaming_cafe_dev.db
ECHO_SQL=false

# Security & Admin Authentication
# (In production, replace with openssl rand -hex 32 and strong passwords)
JWT_SECRET=enterprise_gaming_cafe_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_MINUTES=360

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PHONE=0000000000

# CORS Allowed Origins (Comma-separated URLs or '*' in dev only; wildcard rejected in prod)
ALLOWED_ORIGINS=*
CORS_ORIGINS=*

# Business & Payment Configuration
UPI_MERCHANT_VPA=gamingcafe@upi
UPI_MERCHANT_NAME=ApexCyberLounge
UPI_CURRENCY=INR
DEFAULT_HOURLY_RATE=180.0
DEFAULT_SESSION_DURATION_MINUTES=60
MINIMUM_BILLING_MINUTES=30
GRACE_PERIOD_MINUTES=5
IDEMPOTENCY_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=2000
