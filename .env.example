# ==============================================================================
# Gaming Cafe Management System - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.
# Note: In Docker Compose, service 'db' is reachable at host 'db'.
# For local development outside Docker, use host 'localhost'.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=cafe_admin
POSTGRES_PASSWORD=cyber_secret_2026
POSTGRES_DB=gaming_cafe_db
POSTGRES_PORT=5432

# Backend Database Connection URL
# For Docker Compose: postgresql+asyncpg://cafe_admin:cyber_secret_2026@db:5432/gaming_cafe_db
# For Local Dev:      postgresql+asyncpg://cafe_admin:cyber_secret_2026@localhost:5432/gaming_cafe_db
DATABASE_URL=postgresql+asyncpg://cafe_admin:cyber_secret_2026@localhost:5432/gaming_cafe_db
ECHO_SQL=false

# Security & Authentication (JWT)
JWT_SECRET=enterprise_gaming_cafe_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_MINUTES=360

# Payment & UPI Details
UPI_MERCHANT_VPA=gamingcafe@upi
UPI_MERCHANT_NAME=ApexCyberLounge
