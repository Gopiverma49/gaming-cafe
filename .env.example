# ==============================================================================
# GAMING CAFE MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# 1. NEVER commit your live '.env' file containing real secrets to version control.
# 2. Copy this template to '.env' in your deployment environment:
#      cp .env.example .env
# 3. Fill in cryptographically strong secrets before running in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOST BINDING CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: 'production' | 'development' | 'test'
# When set to 'production', fail-fast guards strictly disallow default credentials,
# default JWT secrets, wildcards in CORS, and non-PostgreSQL databases.
NODE_ENV=production

# Server Host Interface binding (use '0.0.0.0' for Docker, Kubernetes, Cloud VMs)
HOST=0.0.0.0

# Edge / Reverse Proxy / Frontend Port (Public HTTP ingress)
# Fallback: 5000 (standard container port) or hosting-assigned (e.g., 80 / 8080)
PORT=80

# Internal / Microservice Backend Port for FastAPI application
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL PRODUCTION & DOCKER)
# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials (used by docker-compose and postgres container)
POSTGRES_USER=cafe_admin
POSTGRES_PASSWORD=replace_with_strong_production_password_2026
POSTGRES_DB=gaming_cafe_db
POSTGRES_PORT=5432
DB_PORT=5432

# Production Asynchronous Database Connection URL
# Expected dialect: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Examples:
#   - Docker Compose: postgresql+asyncpg://cafe_admin:replace_with_strong_production_password_2026@db:5432/gaming_cafe_db
#   - Managed Supabase: postgresql+asyncpg://postgres.xxxx:your_pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#   - Local Dev:      postgresql+asyncpg://cafe_admin:replace_with_strong_production_password_2026@localhost:5432/gaming_cafe_db
#   - SQLite (Dev only): sqlite+aiosqlite:///./gaming_cafe_dev.db
DATABASE_URL=postgresql+asyncpg://cafe_admin:replace_with_strong_production_password_2026@db:5432/gaming_cafe_db

# Log all executed SQL queries (Set to false in production for performance & security)
ECHO_SQL=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (STRICT ENFORCEMENT)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key used for signing JWT access tokens.
# Generation command: openssl rand -hex 32
JWT_SECRET=replace_with_secure_random_64_char_hex_secret_key_in_production

# JWT signature algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Token expiration durations in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720
CUSTOMER_TOKEN_EXPIRE_MINUTES=360

# Root Administrative Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_complex_admin_passphrase_2026
ADMIN_PHONE=0000000000

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK HARDENING (AUTHORIZED ORIGINS)
# ------------------------------------------------------------------------------
# Allowed origins for CORS (Cross-Origin Resource Sharing).
# In production, wildcards ('*') are strictly FORBIDDEN and rejected at boot.
# Provide a comma-separated list of fully qualified domain origins.
# Format: https://subdomain.domain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=https://gamingcafe.yourdomain.com,https://admin.gamingcafe.yourdomain.com
CORS_ORIGINS=https://gamingcafe.yourdomain.com,https://admin.gamingcafe.yourdomain.com

# ------------------------------------------------------------------------------
# 5. BUSINESS LOGISTICS & UPI BILLING
# ------------------------------------------------------------------------------
# UPI Virtual Payment Address (VPA) for dynamic NPCI Bharat QR generation
UPI_MERCHANT_VPA=gamingcafe@upi
UPI_MERCHANT_NAME=ApexCyberLounge
UPI_CURRENCY=INR

# Default rate per hour in INR
DEFAULT_HOURLY_RATE=180.0
DEFAULT_SESSION_DURATION_MINUTES=60
MINIMUM_BILLING_MINUTES=30
GRACE_PERIOD_MINUTES=5

# Idempotency Cache TTL & Eviction Limit
IDEMPOTENCY_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=2000

# ------------------------------------------------------------------------------
# 6. CLIENT-SAFE FRONTEND VARIABLES (VITE_ PREFIX ONLY)
# ------------------------------------------------------------------------------
# Base API URL consumed by the React single-page application.
# Leave blank when served behind the same Nginx/Cloudflare domain reverse proxy.
# Format: https://api.yourdomain.com (Do not include trailing slash)
VITE_API_BASE_URL=

# WebSocket URL for real-time live events.
# Leave blank to auto-detect window.location.host in production.
# Format: wss://api.yourdomain.com
VITE_WS_URL=

# Set to 'true' only when proxying development HMR over TLS tunnels
VITE_GLOBAL_MODE=false
